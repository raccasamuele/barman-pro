{
    // ═══════════════════════════════════════════════════════════════════
    //   Barman PRO · Cloudflare Workers Assets
    // ═══════════════════════════════════════════════════════════════════
    //
    //   assets.directory punta a "./public": SOLO quella cartella viene
    //   pubblicata. Test, script e documentazione stanno fuori e non
    //   possono finire online per distrazione — per questo qui non serve
    //   nessun .assetsignore.
    //
    //   main non definito → Workers Assets puro, nessun JS server-side.
    //
    //   ⚠️ NON usare `wrangler deploy` per validare una modifica: questo
    //      Worker è quello servito agli utenti. Prima si carica una
    //      versione di preview, si verifica lì, e solo dopo si promuove:
    //
    //        npx wrangler versions upload --preview-alias staging
    //        # verifica sull'URL di preview, poi:
    //        npx wrangler versions deploy
    //
    //      L'alias di preview va rimosso dopo la promozione: resta
    //      pubblico e indicizzabile, e duplicherebbe le pagine SEO.
    // ═══════════════════════════════════════════════════════════════════
    "name": "barman-pro",
    "compatibility_date": "2026-05-23",
    "main": "src/index.js",
  "routes": [{ "pattern": "barmanpro.raccasamuele.it", "custom_domain": true }],
  "workers_dev": true,
    "preview_urls": true,
    "assets": {
        "binding": "ASSETS",
        "run_worker_first": true,
        "directory": "./public"
    },
    "observability": {
        "enabled": true
    }
}
