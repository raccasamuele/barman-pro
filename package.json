{
  "name": "barman-pro",
  "version": "3.0.0-dev",
  "description": "Calcolatore per eventi: quante bottiglie comprare e quanto spendi. Gratuito, senza account, funziona offline.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve": "npx --yes http-server public -p 8099 -c-1 --silent",
    "test": "playwright test",
    "test:golden": "playwright test tests/golden-calc.spec.js tests/golden-wizard.spec.js",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check": "npm run check:i18n && npm run check:forbidden",
    "deploy:preview": "wrangler versions upload --preview-alias staging",
    "deploy:promote": "wrangler versions deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "wrangler": "4.127.1"
  }
}
